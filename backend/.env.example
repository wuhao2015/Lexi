# Copy to .env and fill in values

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Strong secret for production (JWT signing)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: cap Gemini verification calls per UTC day (0 = unlimited)
GEMINI_DAILY_VERIFY_LIMIT=0

# After a 429 on verify, pause Gemini verify for this many seconds
VERIFY_COOLDOWN_SECONDS=3600

# Optional: override SQLite URL (default: backend/data/word_killer.db)
# DATABASE_URL=sqlite:////absolute/path/to/word_killer.db
