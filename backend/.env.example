# Copy to .env and fill in values

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Ordered fallback list. The backend tries each model until one succeeds.
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro,gemini-3-flash-preview

# Strong secret for production (JWT signing)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: cap Gemini verification calls per UTC day (0 = unlimited)
GEMINI_DAILY_VERIFY_LIMIT=0

# After a 429 on verify, pause Gemini verify for this many seconds
VERIFY_COOLDOWN_SECONDS=3600

# Browser origins allowed to call the API (comma-separated). Include your Vercel URL when the SPA is hosted there.
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Scheduled cache maintenance (runs in-process in Lexi service)
# CACHE_MAINTENANCE_ENABLED=true
# CACHE_MAINTENANCE_INTERVAL_SECONDS=86400
# CACHE_MERGE_IDENTICAL_ENABLED=true
# CACHE_CONFLICT_POLICY=keep_highest_quality_score

# Optional: override SQLite URL (default: backend/data/lexi.db)
# DATABASE_URL=sqlite:////absolute/path/to/lexi.db
